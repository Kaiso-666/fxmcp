{
  "name": "fxmcp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "MCP server that drives a local Firefox through the fxmcp bridge extension",
  "bin": {
    "fxmcp": "src/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/index.js",
    "http": "node src/index.js --http",
    "init": "node scripts/init.mjs",
    "build": "web-ext build --source-dir ../extension --artifacts-dir ../dist --overwrite-dest",
    "sign": "web-ext sign --source-dir ../extension --artifacts-dir ../dist --channel unlisted",
    "test": "node test/extract.test.mjs && node test/smoke.mjs",
    "test:e2e": "node test/e2e.mjs",
    "rpc": "node test/rpc.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.20.1",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "jsdom": "^30.1.3",
    "web-ext": "^10.8.0"
  }
}
